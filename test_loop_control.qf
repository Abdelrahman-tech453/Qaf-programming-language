# Test break and continue statements

# 1. Simple break: stop when i == 5
i = 0;
while (true) {
  if (i == 5) {
    break;
  }
  i = i + 1;
}
print i;  # Expected: 5

# 2. Simple continue: sum only odd numbers from 1 to 10
sum_odd = 0;
k = 0;
while (k < 10) {
  k = k + 1;
  if (k % 2 == 0) {
    continue;
  }
  sum_odd = sum_odd + k;
}
print sum_odd; # 1 + 3 + 5 + 7 + 9 = 25. Expected: 25

# 3. Nested loops with break and continue
# Count how many (x, y) pairs have x * y <= 12, breaking inner loop when product > 12
total_pairs = 0;
x = 1;
while (x <= 5) {
  y = 1;
  while (y <= 5) {
    if (x * y > 12) {
      break; # breaks inner loop only
    }
    total_pairs = total_pairs + 1;
    y = y + 1;
  }
  x = x + 1;
}
# For x=1: y=1..5 (5)
# For x=2: y=1..5 (5)
# For x=3: y=1..4 (4) (3*5=15 > 12)
# For x=4: y=1..3 (3) (4*4=16 > 12)
# For x=5: y=1..2 (2) (5*3=15 > 12)
# Total = 5 + 5 + 4 + 3 + 2 = 19
print total_pairs; # Expected: 19
