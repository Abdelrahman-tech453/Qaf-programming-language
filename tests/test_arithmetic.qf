# Test arithmetic operations comprehensively

# Addition
print 0 + 0;
print 1 + 1;
print 100 + 200;

# Subtraction
print 10 - 3;
print 3 - 10;
print 0 - 0;

# Multiplication
print 0 * 100;
print 1 * 99;
print 7 * 8;
print 12 * 12;

# Division
print 10 / 2;
print 7 / 2;
print 99 / 10;
print 1 / 1;

# Modulo
print 10 % 3;
print 7 % 7;
print 15 % 4;
print 100 % 7;

# Operator precedence
print 2 + 3 * 4;
print (2 + 3) * 4;
print 10 - 6 / 2;
print (10 - 6) / 2;
print 2 + 3 * 4 - 1;
print 100 / 10 % 3;

# Associativity (left-to-right)
print 10 - 3 - 2;
print 100 / 10 / 2;

# Unary negation
print -1;
print -0;
print -(3 + 4);
print -(-5);
print 3 + -2;
print 3 * -2;
